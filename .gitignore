# CodeIgniter 4 specific
writable/debugbar/*
writable/logs/*
writable/session/*
writable/uploads/*
writable/cache/*

# Lead-capture fallback storage (contains customer PII — never commit)
writable/leads/*
writable/comments/*

# Environment files
.env
.env.*

# IDE files
.vscode/
.idea/
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db
